* text=auto
*.sh text eol=lf
# Ratchet baselines: union-and-sort instead of a line conflict every time two
# lanes both append. Needs a one-time per-clone driver registration:
#   git config merge.aesop-json-union.name "union-and-sort JSON string lists"
#   git config merge.aesop-json-union.driver "python tools/json_list_merge.py %O %A %B"
# Unregistered clones just get today's ordinary conflict; count-map baselines
# (.portability-baseline.json, .subprocess-guard-baseline.json) are matched here
# but the driver refuses them by shape -- union is unsound for counts.
*-baseline.json merge=aesop-json-union
*.bash text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
# Registered generated artifacts: a structured merge rendered through the
# artifact's own generator instead of git's `union` (which kept both sides'
# lines verbatim and left the index unsorted/duplicated on every merge-from-main;
# #784/#856/#739). One-time per-clone registration, done for you by the pre-push
# hook and by `python tools/install_merge_drivers.py`:
#   git config merge.aesop-regen.driver "python tools/generated_merge.py %O %A %B %L %P"
# Unregistered clones get an ordinary conflict; the committed bytes are verified
# at push by hooks/pre-push-policy.sh check_generated_regen() either way.
tools/INDEX.md merge=aesop-regen
