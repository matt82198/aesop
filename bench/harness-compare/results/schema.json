{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harness comparison result row",
  "description": "One harness run of one corpus task. Written only by record_result.py. passed and check_exit are measured by running the hidden check, never claimed by the harness. Numeric fields may be null when the harness did not report them.",
  "type": "object",
  "required": [
    "harness", "model", "run_id", "task_id", "passed", "check_exit",
    "wall_seconds", "input_tokens", "output_tokens", "cost_usd",
    "turns", "tool_calls", "started_at", "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "harness": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "model": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "task_id": {"type": "string", "minLength": 1},
    "passed": {"type": "boolean"},
    "check_exit": {"type": "integer"},
    "wall_seconds": {"type": "number", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "turns": {"type": ["integer", "null"], "minimum": 0},
    "tool_calls": {"type": ["integer", "null"], "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
